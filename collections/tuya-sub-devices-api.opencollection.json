{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tuya Device Management Device Control Sub Devices API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "client_id",
      "value": "{{client_id}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sub Devices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Sub Devices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tuyaus.com/v1.0/devices/:device_id/sub-devices",
            "params": [
              {
                "name": "device_id",
                "value": "",
                "type": "path",
                "description": "Unique device identifier"
              }
            ]
          },
          "docs": "Retrieve a list of sub-devices connected through a gateway device."
        }
      ]
    }
  ],
  "bundled": true
}