  "info": {
    "_postman_id": "75ee17a9-b9f0-4ab2-bf19-b0c3e742e50b",
    "name": "Tuya Device Management Device Control Sub Devices API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Tuya Device Management API provides endpoints for querying, controlling, and managing IoT devices registered to a Tuya cloud project. Capabilities include device information retrieval, device control, factory reset, device renaming, sub-device listing, operation log queries, and user-device association management.\n\nContact Support:\n Name: Tuya Developer Support\n Email: developer@tuya.com",
      "type": "text/plain"
    }
